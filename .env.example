# The committed template. Copy it twice:
#
#   cp .env.example .env.development   # used by `expo start` and local dev builds
#   cp .env.example .env.production    # used by release builds and `expo export`
#
# Which file is read follows NODE_ENV, which Expo CLI sets per command — see the
# Environments section of AGENTS.md, including why `expo prebuild` reads neither.
# Machine-specific overrides go in .env.development.local. Do not create
# .env.local: it is loaded in every mode and shadows both environments at once.
#
# Restart the dev server after any change — Metro inlines these at build time,
# so edits are not picked up live.
#
# EXPO_PUBLIC_* values are compiled into the JS bundle and can be read out of a
# shipped .ipa/.apk. Public configuration only; never an API key or a secret.
# Build-time secrets belong in EAS secrets.

# development | production. Selects the bundle id, app name and deep-link scheme
# in app.config.ts. Anything else is treated as development.
# Not EXPO_PUBLIC_*: it is read at build time only and never reaches the bundle.
APP_VARIANT=development

EXPO_PUBLIC_API_URL=https://api.example.com/v1

# PostHog project API key, from your project's settings page.
# Optional: without it analytics is off and the app logs one warning at startup.
EXPO_PUBLIC_POSTHOG_API_KEY=

# Only needed for an EU project or a self-hosted instance.
# Defaults to https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=
